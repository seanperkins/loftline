{
  "name": "3D preview playback: the stock must hold still while the tool cuts (the bar below must not re-wrap)",
  "appearance": "dark",
  "window": [1280, 820],
  "steps": [
    {"op": "project", "name": "harness/projects/reel-sign.loftline"},
    {"op": "tab", "value": "toolpaths"},
    {"op": "calculate"},
    {"op": "press", "name": "3D", "value": "AXRadioButton"},
    {"op": "wait", "seconds": 4},
    {"op": "press", "name": "Back to start", "value": "AXButton"},
    {"op": "wait", "seconds": 1},
    {"op": "record", "name": "play", "fps": 20},
    {"op": "press", "name": "Play", "value": "AXButton"},
    {"op": "wait", "seconds": 5},
    {"op": "endRecord"}
  ]
}
